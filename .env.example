# Copy to `.env` for local Compose / Render. Do not commit real secrets.
#   cp .env.example .env

# --- API security (recommended for any public URL) ---
API_KEY=
RATE_LIMIT_PER_MINUTE=120

# --- Logging / serving ---
LOG_LEVEL=INFO
SERVING_MODE=primary
CANARY_PERCENT=0
SPLIT_MODE=temporal

# --- Prediction cache (lowers inference latency on repeated payloads) ---
PREDICT_CACHE_ENABLED=1
PREDICT_CACHE_SIZE=1024
PREDICT_CACHE_TTL_SECONDS=300

# --- Latency model ---
# When 1, /api/predict may omit latency_ms and the latency model fills it.
LATENCY_MODEL_ENABLED=1

# --- Optional audit log (SQLite with indexes) ---
AUDIT_LOG_ENABLED=1
# Local/Compose default; on Render use /tmp/predict_audit.db (ephemeral).
AUDIT_LOG_PATH=artifacts/ops/predict_audit.db

# --- Async batch jobs (in-process queue; single worker) ---
ASYNC_JOBS_ENABLED=1
